# ------------------------------------------------------------------
# Tradeork - environment template
# Copy to .env and adjust values. Never commit real secrets.
# ------------------------------------------------------------------

# Application
ENVIRONMENT=development

# Used to sign JWTs. MUST be replaced with a long random value in production.
SECRET_KEY=change-me-in-production

# Database (used by docker-compose)
POSTGRES_USER=tradeork
POSTGRES_PASSWORD=tradeork
POSTGRES_DB=tradeork

# Backend
# Comma-separated list of allowed CORS origins for the SPA.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Market data provider.
#   mock    -> synthetic quotes, always labelled is_mock=true (default)
#   upstox  -> live Upstox v2 REST quotes (requires credentials below)
MARKET_DATA_PROVIDER=mock

# Poll interval (seconds) between quote refreshes (REST + WebSocket stream).
MARKET_DATA_POLL_INTERVAL=2.0

# Paper trading engine.
# Background loop that fills pending LIMIT orders once marketable.
PAPER_MATCHER_ENABLED=true
PAPER_MATCHER_INTERVAL=5.0

# Broker execution adapter (LIVE side of PAPER/LIVE separation).
#   mock    -> in-process simulator, is_mock=true (default)
#   upstox  -> live Upstox v2 order placement (requires credentials below)
# The paper engine never calls a broker; this seam is for a future live mode.
BROKER_ADAPTER=mock
# Upstox product used for order placement (D=delivery).
UPSTOX_BROKER_PRODUCT=D

# Master switch for LIVE portfolios (execution_mode=live). Default false:
# portfolios stay paper-only and live orders are rejected even if a broker
# adapter is configured.
LIVE_EXECUTION_ENABLED=false

# Upstox v2 API credentials. Only needed when MARKET_DATA_PROVIDER=upstox
# and/or BROKER_ADAPTER=upstox.
# Use a long-lived app access token (OAuth refresh flow is out of scope).
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com/v2
